# Unity crash / build reports
# ---------------------------------------------
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# ---------------------------------------------
# ML-Agents training artefacts
# PyTorch checkpoints are only needed to resume training, keep the repo light.
# The exported .onnx policies and TensorBoard logs are kept on purpose.
# ---------------------------------------------
*.pt
/results/**/*.pt

